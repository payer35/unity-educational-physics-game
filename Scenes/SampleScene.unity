MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 167540351}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17ebf9e6065a73646817eac6e74b1df3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 884145226}
  nameInputField: {fileID: 578729338}
  nameInput: {fileID: 578729340}
  nameWarningPopup: {fileID: 2033420072}
  IntroCanvas: {fileID: 1097841591}
  FirstActivityCanvas: {fileID: 1568621998}
  characterAnimator: {fileID: 1676076129}
  introductionActivityDialogues:
  - "Merhaba, ekibimize kat\u0131lmaya hak kazanan Yavrukurt sensin demek. Ben izcilerin
    lideri: Ergin \u0130zci."
  - "Ad\u0131n\u0131 \xF6\u011Frenebilir miyim, Yavrukurt?"
  - "Seninle tan\u0131\u015Ft\u0131\u011F\u0131ma \xE7ok memnun oldum [name]! Bilim
    & Do\u011Fa izci grubuna ho\u015F geldin! Maceralara at\u0131lmak i\xE7in sab\u0131rs\u0131zlan\u0131yor
    olmal\u0131s\u0131n! Haydi, sana biraz grubumuzdan bahsedeyim."
  - "Bilim & Do\u011Fa grubu olarak bir\xE7ok maceraya at\u0131l\u0131yoruz, \xE7e\u015Fitli
    zorluklarla kar\u015F\u0131la\u015F\u0131yoruz ve do\u011Fada hayatta kalmaya
    \xE7al\u0131\u015F\u0131yoruz. T\xFCm bunlar\u0131n \xFCstesinden ise bilimin
    bize sundu\u011Fu harika bilgiler ile geliyoruz."
